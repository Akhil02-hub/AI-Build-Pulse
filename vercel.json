{
    "buildCommand": "",
    "outputDirectory": ".",
    "rewrites": [
        {
            "source": "/((?!.*\\.(css|js|png|json|svg|ico|woff2?|html)$).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/data/news.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(styles|config|app)\\.(css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}